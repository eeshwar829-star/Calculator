def calculate():
    """
    A basic command-line calculator function that performs
    simple arithmetic operations based on user input.
    """
    print("\n--- Basic Command-Line Calculator ---")
    print("Select operation:")
    print("1. Add (+)")
    print("2. Subtract (-)")
    print("3. Multiply (*)")
    print("4. Divide (/)")
    print("5. Exit")
    print("-" * 35)

    while True:
        # Take input from the user
        choice = input("Enter choice (1/2/3/4/5): ")

        # Check if choice is one of the valid options
        if choice in ('1', '2', '3', '4'):
            try:
                num1 = float(input("Enter first number: "))
                num2 = float(input("Enter second number: "))
            except ValueError:
                print("Invalid input. Please enter a valid number.")
                continue

            operator = ""
            result = 0

            if choice == '1':
                operator = "+"
                result = num1 + num2
            elif choice == '2':
                operator = "-"
                result = num1 - num2
            elif choice == '3':
                operator = "*"
                result = num1 * num2
            elif choice == '4':
                if num2 == 0:
                    print("Error! Division by zero is not allowed.")
                    continue
                operator = "/"
                result = num1 / num2
            
            print(f"\n{num1} {operator} {num2} = {result}\n")
            
            # Ask if the user wants to continue
            next_calculation = input("Do you want to perform another calculation? (yes/no): ")
            if next_calculation.lower() != 'yes':
                break

        elif choice == '5':
            print("Calculator exited. Goodbye! 👋")
            break

        else:
            print("Invalid Input. Please enter a number between 1 and 5.")

# Run the calculator
if __name__ == "__main__":
    calculate()
